# docker compose uchun namuna — `.env` nomi bilan nusxa oling:
#   cp .env.docker.example .env
#
# docker compose bu qiymatlarni avtomatik o'qiydi.

# --- Baza (ixtiyoriy — standart qiymatlar yetarli) ---
POSTGRES_USER=challanger
POSTGRES_PASSWORD=challanger
POSTGRES_DB=challanger

# --- Ilova ---
# ⚠️ Prodda albatta uzun tasodifiy qiymatga o'zgartiring: `openssl rand -hex 32`
JWT_SECRET=CHANGE-ME-in-production

# Tashqi port (host:3000 -> konteyner:3000)
APP_PORT=3000

# --- Telegram bot (ixtiyoriy) ---
# @BotFather'dan olingan token. Bo'sh qoldirsangiz bot o'chiq turadi.
TELEGRAM_BOT_TOKEN=

# --- Web Push (ixtiyoriy) ---
# Brauzer push bildirishnomasi (ilova yopiq bo'lsa ham keladi).
# VAPID maxfiy kaliti (xom 32 bayt, base64url). Ochiq kalit undan avtomatik hosil bo'ladi.
# Yangi kalit yaratish (docs/deploy.md dagi buyruq):
#   openssl ecparam -name prime256v1 -genkey ... (batafsil docs/deploy.md)
# Bo'sh qoldirsangiz push o'chiq turadi.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@challanger.app
